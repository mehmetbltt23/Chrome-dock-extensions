{
  "name": "docktabs",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Arc-inspired persistent shortcuts and tab companion for Chrome.",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/validate-build.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "validate": "node scripts/validate-project.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.10.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
